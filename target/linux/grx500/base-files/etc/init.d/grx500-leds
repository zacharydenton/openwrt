#!/bin/sh /etc/rc.common
START=97
USE_PROCD=1

start_service() {
	[ "$(board_name)" = "tplink,archer-ax3000-v1" ] || return 0
	/usr/libexec/grx500-leds update
	procd_open_instance
	procd_set_param command /usr/libexec/grx500-leds watch
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	/usr/libexec/grx500-leds update
}

service_triggers() {
	procd_add_reload_trigger system
	procd_add_raw_trigger "netifd.wireless.done" 1000 /usr/libexec/grx500-leds update
	procd_add_raw_trigger "grx500.leds.update" 1000 /usr/libexec/grx500-leds update
}
