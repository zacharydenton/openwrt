    "archive_sha256": "88308b69462ab4a664e88718f006717125e8ca1aa3b921853c91f651e2611232",
    "patch": "ugw_linux_patches/0016-Add-support-for-lantiq-datapath-driver-common.patch",
    "patch_sha256": "b775f9bb55dfc395654b254425b89b61f0c814669e7998860d90a3e7137c6832",
    "evidence": [
      "the datapath calls rx_fn(dev, NULL, skb, len) for receive mode",
      "the datapath calls rx_fn(NULL, dev, skb, len) for transmit mode",
      "the primary-source example txif callback assigns skb->dev and calls dev_queue_xmit"
    ]
  },
  "source": {
    "path": "target/linux/grx500/files/drivers/net/ethernet/lantiq/ltq_eth_drv_xrx500.c",
    "sha256": "0427a09891f83c77cd669c4074c13b8c8fa8e6662ff34964eaa30efb177ac080",
    "caller": "target/linux/grx500/files/drivers/net/datapath/dpm/gswip30/datapath_rx.c",
    "before": [
      "every valid callback with only txif set was freed instead of transmitted",
      "the callback trusted len and PMAC/header linearity and retained any DMA tail beyond len",
      "netif_rx backlog drops were counted as received packets",
      "receive and transmit callbacks did not reject a down netdev"
    ],
    "after": [
      "null, negative, short, overreported, inaccessible-header and trim-failure inputs are rejected with direction-appropriate statistics",
      "the callback length is authoritative and excess DMA tail bytes are trimmed before PMAC removal",
      "receive mode requires a running netdev and propagates NET_RX_DROP as failure",
      "transmit mode requires a running netdev, sets skb->dev, calls dev_queue_xmit and evaluates its return without double-freeing its consumed skb"
    ],
    "adjacent_compatibility": [
      "MAC changes use eth_hw_addr_set and a mutable local address for the legacy MAC operation",
      "pause results are fully initialized and AUTO's intentional RXTX fallthrough is annotated",
      "the switch register helper is static and scoped to CONFIG_USE_EMULATOR"
    ]
  },
