  "status": "GRX500 datapath callback failures are now classified as drops rather than RX, redirected-TX or LCT-clone successes; skb ownership and the outer handled-packet return contract are unchanged, and hardware execution remains outstanding.",
  "hardware_tested": false,
  "release_gate": {
    "source_and_build_gate_passed": true,
    "physical_ethernet_gate_passed": false,
    "upload_recommended": false
  },
  "primary_source": {
    "repository": "https://gitlab.com/prpl-foundation/intel/linux.git",
    "ref": "ugw-8.5.2",
    "archive_sha256": "88308b69462ab4a664e88718f006717125e8ca1aa3b921853c91f651e2611232",
    "patch": "ugw_linux_patches/1587-DRV-DPM-SW-430-DPM-restructure-rx-APIs.patch",
    "patch_sha256": "b4248aa824e2ab4b23322e97722d0d0c45213e30cae0a30a6306e2e769a631cb",
    "evidence": [
      "the later _dp_rx interface explicitly returns DP_SUCCESS because errors are handled internally",
      "normal RX, redirected TX and LCT callbacks transfer skb ownership to the registered callback",
      "the outer CQM receive producers ignore dp_rx's return"
    ]
  },
  "source": {
    "path": "target/linux/grx500/files/drivers/net/datapath/dpm/gswip30/datapath_rx.c",
    "sha256": "a16b32aa79e1f6f009591ab1cbda1282e0f052da46ed2c6f559d2bb59b2ac73d",
    "before": [
      "all four callback sites ignored the callback result",
      "normal RX, redirected TX and LCT deliveries incremented success counters even after callback failure"
    ],
    "after": [
      "DP_SUCCESS increments exactly the delivery-specific per-subinterface and global success counters",
      "any nonzero callback result increments rx_fn_dropped and global rx_drop without incrementing a success counter",
      "the callback retains skb ownership on every result; the datapath does not retry or free it",
      "the outer handled-packet return remains DP_SUCCESS, matching its existing ownership contract"
    ],
    "delivery_sites": [
      "normal RX",
      "redirected TX",
      "LCT multicast/broadcast clone",
      "LCT unicast RX"
    ]
  },
  "test": {
    "path": "target/linux/grx500/tests/test-datapath-rx-accounting.py",
    "sha256": "3c45a54e810ca76dd000d154a8e1369de2ab18fa2a8cdcfa2b04f29146dd0c83",
    "compiler": "native GCC with ASan/UBSan and -Wall -Wextra -Werror",
    "production_code_extracted": "dp_rx_deliver",
    "exit_code": 0,
    "cases": 7,
    "coverage": [
