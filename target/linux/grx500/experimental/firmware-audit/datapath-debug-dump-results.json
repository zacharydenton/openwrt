    "before": [
      "the zero-port RX error path always selected a length at least as large as both skb->len and dp_print_len",
      "RX and TX raw-pointer dumps could use nonlinear total skb length"
    ],
    "after": [
      "all raw skb data dumps stop at skb_headlen",
      "an offset at or beyond the linear head produces a zero-byte dump",
      "a positive print length caps the remaining linear bytes",
      "a non-positive print length preserves a full dump of an ordinary linear skb"
    ]
  },
