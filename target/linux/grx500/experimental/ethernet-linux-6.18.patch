+	if (frag_size <= overhead || frag_size > capacity)
+		return NULL;
+	skb = alloc_skb(frag_size - overhead, priority);
+	if (!skb)
+		return NULL;
+	memcpy(skb->data, data, frag_size - overhead);
+	cbm_buffer_free_grx500(smp_processor_id(), data, 0);
+	return skb;
