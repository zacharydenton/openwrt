+ */
+static struct sk_buff *build_skb_grx500(void *data, u32 frag_size, gfp_t priority)
+{
+	struct sk_buff *skb;
+	u32 overhead = SKB_DATA_ALIGN(sizeof(struct skb_shared_info));
+	u32 capacity;
