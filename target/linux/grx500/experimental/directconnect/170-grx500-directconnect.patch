+/* DirectConnect station teardown: preserve bridge policy/static entries. */
+int dc_dp_br_fdb_delete(struct net_device *dev, const unsigned char *addr)
+{
+	struct net_bridge_port *p;
+	struct net_bridge_fdb_entry *f;
+	struct hlist_node *next;
+	int ret = -ENODEV;
+
+	rcu_read_lock();
+	p = br_port_get_rcu(dev);
+	if (!p)
+		goto out;
+	spin_lock_bh(&p->br->hash_lock);
+	hlist_for_each_entry_safe(f, next, &p->br->fdb_list, fdb_node) {
+		if (READ_ONCE(f->dst) != p || test_bit(BR_FDB_LOCAL, &f->flags) ||
+		    test_bit(BR_FDB_STATIC, &f->flags) ||
+		    (addr && !ether_addr_equal(f->key.addr.addr, addr)))
+			continue;
+		fdb_delete(p->br, f, true);
+	}
+	spin_unlock_bh(&p->br->hash_lock);
+	ret = 0;
+ out:
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dc_dp_br_fdb_delete);
 
