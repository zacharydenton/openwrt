+{
+  int res;
+  wave_rcvry_task_ctx_t *rcvry_ctx = &pcard->rcvry_ctx;
+
+  /* Publish the recovery type, snapshot VAPs and queue their commands as
+   * one operation with respect to interface creation and deletion. */
+  mtlk_osal_mutex_acquire(&rcvry_ctx->vap_change_mutex);
+  res = __rcvry_task_initiate(pcard);
+  mtlk_osal_mutex_release(&rcvry_ctx->vap_change_mutex);
+  return res;
 }
 
