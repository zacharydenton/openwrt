+static int
+_mtlk_core_vap_change_guard (mtlk_handle_t hcore, const void *data,
+                             uint32 data_size, mtlk_core_task_func_t handler)
+{
+  mtlk_core_t *core = HANDLE_T_PTR(mtlk_core_t, hcore);
+  mtlk_hw_t *hw = mtlk_vap_get_hw(core->vap_handle);
+  mtlk_clpb_t *clpb = *(mtlk_clpb_t **)data;
+  BOOL held;
+  int res;
+
+  MTLK_ASSERT(sizeof(mtlk_clpb_t *) == data_size);
+  res = wave_rcvry_vap_change_begin(hw, &held);
+  if (res != MTLK_ERR_OK)
+    return mtlk_clpb_push_res(clpb, res);
+
+  res = handler(hcore, data, data_size);
+  wave_rcvry_vap_change_end(hw, held);
+  return res;
+}
+
+static int _mtlk_core_add_vap_idx_guarded (mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  return _mtlk_core_vap_change_guard(hcore, data, data_size, _mtlk_core_add_vap_idx);
+}
+
+static int _mtlk_core_add_vap_name_guarded (mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  return _mtlk_core_vap_change_guard(hcore, data, data_size, _mtlk_core_add_vap_name);
+}
+
+static int _mtlk_core_del_vap_idx_guarded (mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  return _mtlk_core_vap_change_guard(hcore, data, data_size, _mtlk_core_del_vap_idx);
+}
+
+static int _mtlk_core_del_vap_name_guarded (mtlk_handle_t hcore, const void *data, uint32 data_size)
+{
+  return _mtlk_core_vap_change_guard(hcore, data, data_size, _mtlk_core_del_vap_name);
 }
 
