+
+int wave_rcvry_vap_change_begin (const mtlk_hw_t *hw_ctx, BOOL *held)
+{
+  wave_rcvry_task_ctx_t *rcvry_ctx = _rcvry_task_ctx_get(hw_ctx);
+
+  *held = FALSE;
+  /* Startup and module teardown have no active recovery task. */
+  if (!rcvry_ctx || !_rcvry_is_initialized(rcvry_ctx))
+    return MTLK_ERR_OK;
+
+  mtlk_osal_mutex_acquire(&rcvry_ctx->vap_change_mutex);
+  if (__rcvry_type_current_get(rcvry_ctx) != RCVRY_TYPE_UNDEF ||
+      atomic_read(&rcvry_ctx->is_mac_fatal_pending)) {
+    mtlk_osal_mutex_release(&rcvry_ctx->vap_change_mutex);
+    return MTLK_ERR_RETRY;
+  }
+
+  *held = TRUE;
+  return MTLK_ERR_OK;
+}
+
+void wave_rcvry_vap_change_end (const mtlk_hw_t *hw_ctx, BOOL held)
+{
+  wave_rcvry_task_ctx_t *rcvry_ctx;
+
+  if (!held)
+    return;
+
+  rcvry_ctx = _rcvry_task_ctx_get(hw_ctx);
+  MTLK_ASSERT(rcvry_ctx != NULL);
+  mtlk_osal_mutex_release(&rcvry_ctx->vap_change_mutex);
 }
 
