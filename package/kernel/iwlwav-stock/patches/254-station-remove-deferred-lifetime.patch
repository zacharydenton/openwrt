+static int
+wave_sta_vap_delete_one (wv_mac80211_t *mac80211,
+                         mtlk_vap_handle_t vap_handle)
+{
+  mtlk_mbss_cfg_t mbss_cfg;
+  mtlk_clpb_t *clpb = NULL;
+  mtlk_df_t *master_df = _wv_mac80211_master_df_get(mac80211);
+  int res;
+
+  if (!master_df)
+    return MTLK_ERR_NOT_READY;
+
+  memset(&mbss_cfg, 0, sizeof(mbss_cfg));
+  mbss_cfg.vap_handle = vap_handle;
+  res = _mtlk_df_user_invoke_core(master_df,
+      WAVE_RADIO_REQ_MBSS_DEL_VAP_NAME, &clpb,
+      &mbss_cfg, sizeof(mbss_cfg));
+  return _mtlk_df_user_process_core_retval(res, clpb,
+      WAVE_RADIO_REQ_MBSS_DEL_VAP_NAME, TRUE);
+}
+
+static bool
+wave_sta_vap_delete_pending (wv_mac80211_t *mac80211)
+{
+  int i, max_vaps_count = __wv_mac80211_max_vaps_count_get(mac80211);
+  bool pending = false;
+
+  mutex_lock(&mac80211->vap_delete_mutex);
+  for (i = 0; i < max_vaps_count; i++) {
+    if (mac80211->pending_vap_delete[i]) {
+      pending = true;
+      break;
+    }
+  }
+  mutex_unlock(&mac80211->vap_delete_mutex);
+  return pending;
+}
+
+static void
+wave_sta_vap_delete_work (struct work_struct *work)
+{
+  wv_mac80211_t *mac80211 = container_of(to_delayed_work(work),
+      wv_mac80211_t, vap_delete_work);
+  int i, max_vaps_count = __wv_mac80211_max_vaps_count_get(mac80211);
+  bool retry = false;
+
+  mutex_lock(&mac80211->vap_delete_mutex);
+  for (i = 0; i < max_vaps_count; i++) {
+    mtlk_vap_handle_t vap_handle = mac80211->pending_vap_delete[i];
+
+    if (!vap_handle)
+      continue;
+    if (MTLK_ERR_OK == wave_sta_vap_delete_one(mac80211, vap_handle))
+      mac80211->pending_vap_delete[i] = NULL;
+    else
+      retry = true;
+  }
+  if (retry && !mac80211->vap_delete_stopping)
+    schedule_delayed_work(&mac80211->vap_delete_work,
+                          msecs_to_jiffies(1000));
+  mutex_unlock(&mac80211->vap_delete_mutex);
+}
+
+static void
+wave_sta_vap_delete_defer (wv_mac80211_t *mac80211,
+                           mtlk_vap_handle_t vap_handle)
+{
+  unsigned int vap_index = mtlk_vap_get_id(vap_handle);
+  unsigned int max_vaps_count = __wv_mac80211_max_vaps_count_get(mac80211);
+
+  mutex_lock(&mac80211->vap_delete_mutex);
+  if (vap_index >= max_vaps_count) {
+    ELOG_D("Invalid deferred station VAP index %d", vap_index);
+  } else if (mac80211->pending_vap_delete[vap_index] &&
+             mac80211->pending_vap_delete[vap_index] != vap_handle) {
+    ELOG_D("Deferred station VAP slot %d is already occupied", vap_index);
+  } else {
+    mac80211->pending_vap_delete[vap_index] = vap_handle;
+    if (!mac80211->vap_delete_stopping)
+      schedule_delayed_work(&mac80211->vap_delete_work,
+                            msecs_to_jiffies(1000));
+  }
+  mutex_unlock(&mac80211->vap_delete_mutex);
+}
+
+static void
+wave_sta_vap_delete_stop (wv_mac80211_t *mac80211)
+{
+  mutex_lock(&mac80211->vap_delete_mutex);
+  mac80211->vap_delete_stopping = true;
+  mutex_unlock(&mac80211->vap_delete_mutex);
+  cancel_delayed_work_sync(&mac80211->vap_delete_work);
+}
