+
+static void
+wave_bss_tx_release_packets(mtlk_hw_t *hw, mtlk_mmb_advanced_bdr_t *control)
+{
+  int i;
+
+  for (i = 0; i < control->basic.nof_bds; i++) {
+    struct mtlk_hw_bss_req_mirror *req =
+      _mtlk_basic_bdr_get_mirror_bd(&control->basic, i, struct mtlk_hw_bss_req_mirror);
+    struct sk_buff *skb = req->skb;
+
+    req->skb = NULL;
+    req->cookie = 0;
+    if (skb) {
+      wave_radio_t *radio = __mtlk_hw_wave_radio_get(hw, req->radio_id);
+      struct ieee80211_hw *mac_hw = radio ? wave_radio_ieee80211_hw_get(radio) : NULL;
+
+      /* Accepted skbs originate from mac80211. Report a dropped TX while
+       * that owner is alive, including frames still in the reserve queue.
+       */
+      if (mac_hw)
+        ieee80211_free_txskb(mac_hw, skb);
+      else
+        dev_kfree_skb_any(skb);
+    }
+  }
+}
+
+void __MTLK_IFUNC
+mtlk_hw_mmb_release_bss_tx(mtlk_hw_t *hw)
+{
+  if (!(hw->flags & HW_FLAGS_PREPARED_BSS_REQ_BDR))
+    return;
+
+  _mtlk_mmb_unmap_bss_tx_buffers(hw, &hw->bss_mgmt.tx_bdr);
+  _mtlk_mmb_unmap_bss_tx_buffers(hw, &hw->bss_mgmt.tx_res_bdr);
+  wave_bss_tx_release_packets(hw, &hw->bss_mgmt.tx_bdr);
+  wave_bss_tx_release_packets(hw, &hw->bss_mgmt.tx_res_bdr);
 }
 
