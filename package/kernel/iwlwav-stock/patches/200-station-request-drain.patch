+/* Counts queued station TX requests through their completion callback.
+ * This lifetime is deliberately separate from the hardware TX ring gate:
+ * recovery must not wait for work queued behind itself in a serializer. */
+struct wave_sta_tx_lifetime {
+  spinlock_t lock;
+  wait_queue_head_t wait;
+  unsigned int users;
+  bool stopping;
+};
+
 struct _wv_mac80211_t
 {
+  struct wave_sta_tx_lifetime tx_lifetime;
   BOOL registered;
   /* mtlk_vap_manager_t *vap_manager; */
   wave_radio_t        *radio;
   struct ieee80211_hw *mac80211_hw;
   struct ieee80211_vif **vif_array;
 };
+
+static void
+wave_sta_tx_lifetime_init(wv_mac80211_t *mac80211)
+{
+  spin_lock_init(&mac80211->tx_lifetime.lock);
+  init_waitqueue_head(&mac80211->tx_lifetime.wait);
+  mac80211->tx_lifetime.users = 0;
+  mac80211->tx_lifetime.stopping = false;
+}
+
+static bool
+wave_sta_tx_get(wv_mac80211_t *mac80211)
+{
+  unsigned long flags;
+  bool accepted;
+
+  spin_lock_irqsave(&mac80211->tx_lifetime.lock, flags);
+  accepted = !mac80211->tx_lifetime.stopping;
+  if (accepted)
+    mac80211->tx_lifetime.users++;
+  spin_unlock_irqrestore(&mac80211->tx_lifetime.lock, flags);
+  return accepted;
+}
+
+static void
+wave_sta_tx_put(wv_mac80211_t *mac80211)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&mac80211->tx_lifetime.lock, flags);
+  if (WARN_ON_ONCE(!mac80211->tx_lifetime.users)) {
+    spin_unlock_irqrestore(&mac80211->tx_lifetime.lock, flags);
+    return;
+  }
+  if (!--mac80211->tx_lifetime.users)
+    wake_up_all(&mac80211->tx_lifetime.wait);
+  spin_unlock_irqrestore(&mac80211->tx_lifetime.lock, flags);
+}
+
+static bool
+wave_sta_tx_idle(wv_mac80211_t *mac80211)
+{
+  unsigned long flags;
+  bool idle;
+
+  /* Wait for the final put to finish touching the owner's waitqueue too. */
+  spin_lock_irqsave(&mac80211->tx_lifetime.lock, flags);
+  idle = !mac80211->tx_lifetime.users;
+  spin_unlock_irqrestore(&mac80211->tx_lifetime.lock, flags);
+  return idle;
+}
+
+void __MTLK_IFUNC
+wv_ieee80211_tx_quiesce(wv_mac80211_t *mac80211)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&mac80211->tx_lifetime.lock, flags);
+  mac80211->tx_lifetime.stopping = true;
+  spin_unlock_irqrestore(&mac80211->tx_lifetime.lock, flags);
+  wait_event(mac80211->tx_lifetime.wait, wave_sta_tx_idle(mac80211));
+}
 
