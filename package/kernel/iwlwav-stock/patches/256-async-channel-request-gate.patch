+BOOL scan_support_channel_request_enter(struct scan_support *ss)
+{
+  unsigned long flags;
+  BOOL accepted;
+
+  spin_lock_irqsave(&ss->channel_req_lock, flags);
+  accepted = !ss->removal_pending;
+  if (accepted)
+    ss->channel_req_users++;
+  spin_unlock_irqrestore(&ss->channel_req_lock, flags);
+
+  return accepted;
+}
+
+void scan_support_channel_request_exit(struct scan_support *ss)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&ss->channel_req_lock, flags);
+  if (WARN_ON_ONCE(!ss->channel_req_users)) {
+    spin_unlock_irqrestore(&ss->channel_req_lock, flags);
+    return;
+  }
+  if (!--ss->channel_req_users)
+    wake_up_all(&ss->channel_req_wait);
+  spin_unlock_irqrestore(&ss->channel_req_lock, flags);
+}
+
+static BOOL scan_support_channel_requests_idle(struct scan_support *ss)
+{
+  unsigned long flags;
+  BOOL idle;
+
+  spin_lock_irqsave(&ss->channel_req_lock, flags);
+  idle = !ss->channel_req_users;
+  spin_unlock_irqrestore(&ss->channel_req_lock, flags);
+  return idle;
+}
+
