    * needed for the scan abort. Release it before waiting for either timer.
@@ -657,6 +706,10 @@ void scan_support_prepare_remove(struct s
   wave_radio_on_rcvry_isolate(wave_vap_radio_get(ss->master_core->vap_handle));
   mtlk_osal_timer_cancel_sync(&ss->master_core->slow_ctx->cac_timer);
   mtlk_osal_timer_cancel_sync(&ss->master_core->slow_ctx->sched_scan_timer);
+
+  /* A producer admitted before removal may still be copying its request. */
+  wait_event(ss->channel_req_wait,
