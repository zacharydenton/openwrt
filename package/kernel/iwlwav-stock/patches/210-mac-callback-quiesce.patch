+/* The normal event gate also stops data confirmations. Let already accepted
+ * data and BSS frames finish while their VAP/core/mac80211 owners are still
+ * present. The TX producer gate is closed before this process-context wait.
+ */
+static void
+_mtlk_hw_mmb_wait_packet_completions(mtlk_hw_t *hw)
+{
+  uint32 data_pending = 0, bss_pending = 0;
+  int attempt;
+
+  for (attempt = 0; attempt < 200; attempt++) {
+    data_pending = 0;
+    bss_pending = 0;
+    if (hw->flags & HW_FLAGS_PREPARED_DATA_REQ_BDR) {
+      mtlk_osal_lock_acquire(&hw->tx.bdr_data.lock);
+      data_pending = mtlk_dlist_size(&hw->tx.bdr_data.used_list);
+      mtlk_osal_lock_release(&hw->tx.bdr_data.lock);
+    }
+    if (hw->flags & HW_FLAGS_PREPARED_BSS_REQ_BDR) {
+      mtlk_osal_lock_acquire(&hw->bss_mgmt.tx_bdr.lock);
+      bss_pending = mtlk_dlist_size(&hw->bss_mgmt.tx_bdr.used_list) +
+                    mtlk_dlist_size(&hw->bss_mgmt.tx_res_bdr.used_list);
+      mtlk_osal_lock_release(&hw->bss_mgmt.tx_bdr.lock);
+    }
+    if (!data_pending && !bss_pending)
+      return;
+    mtlk_osal_msleep(10);
+  }
+  WLOG_DD("Pending packet confirmations during mac80211 removal: data=%u, bss=%u",
+          data_pending, bss_pending);
+}
+
+/* mac80211 unregister removes interfaces while firmware command confirmations
+ * are still needed by their stop paths. Stop packet producers, wait for any
+ * running tasklet, and return accepted management skbs before unregister.
+ * The firmware may still own the separate DMA buffers: they are unmapped only
+ * by the reset/stop path after the device has stopped using them.
+ */
+void __MTLK_IFUNC
+mtlk_hw_mmb_quiesce_mac80211(mtlk_hw_t *hw)
+{
+  mtlk_handle_t lock_val;
+  BOOL resume_irqs = !READ_ONCE(hw->mac_events_stopped_completely);
+
+  if (resume_irqs)
+    _mtlk_hw_mmb_wait_packet_completions(hw);
+  WRITE_ONCE(hw->mac_events_stopped, 1);
+  mtlk_mmb_drv_recovery_irq_quiesce(hw);
+
+  if (hw->flags & HW_FLAGS_PREPARED_BSS_REQ_BDR) {
+    wave_bss_tx_release_packets(hw, &hw->bss_mgmt.tx_bdr);
+    wave_bss_tx_release_packets(hw, &hw->bss_mgmt.tx_res_bdr);
+  }
+
+  if (!resume_irqs)
+    return;
+
+  /* Restore command replies and BSS completion accounting for VAP removal.
+   * mac_events_stopped keeps RX and status callbacks closed.
+   */
+  mtlk_mmb_drv_recovery_irq_resume(hw);
+  lock_val = mtlk_osal_lock_acquire_irq(&hw->reg_lock);
+  mtlk_ccr_enable_interrupts(hw->ccr, MTLK_IRQ_ALL);
+  mtlk_osal_lock_release_irq(&hw->reg_lock, lock_val);
+}
