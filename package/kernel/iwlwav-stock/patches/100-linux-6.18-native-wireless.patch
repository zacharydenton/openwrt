+/* Synchronous GMAC with no plaintext. Authenticate AAD || management body
+ * (including the zero MIC), then obtain the 16-byte tag. All SG storage is
+ * heap-backed so this also works with VMAP_STACK. */
+static int wave_pmf_gmac(struct crypto_aead *tfm, const u8 *aad, const u8 *body,
+                         size_t body_len, const u8 *sa, u64 ipn, u8 *mic)
+{
+  struct aead_request *req;
+  struct scatterlist sg;
+  u8 iv[16] = {}, *input;
+  unsigned int i;
+  int err;
+
+  input = kmalloc(20 + body_len + 16, GFP_ATOMIC);
+  if (!input)
+    return -ENOMEM;
+  req = aead_request_alloc(tfm, GFP_ATOMIC);
+  if (!req) {
+    kfree(input);
+    return -ENOMEM;
+  }
+  memcpy(input, aad, 20);
+  memcpy(input + 20, body, body_len);
+  memcpy(iv, sa, 6);
+  for (i = 0; i < 6; i++)
+    iv[6 + i] = ipn >> (8 * (5 - i));
+  iv[15] = 1;
+  sg_init_one(&sg, input, 20 + body_len + 16);
+  aead_request_set_callback(req, 0, NULL, NULL);
+  aead_request_set_crypt(req, &sg, &sg, 0, iv);
+  aead_request_set_ad(req, 20 + body_len);
+  err = crypto_aead_encrypt(req);
+  if (!err)
+    memcpy(mic, input + 20 + body_len, 16);
+  aead_request_free(req);
+  kfree_sensitive(input);
+  return err;
+}
