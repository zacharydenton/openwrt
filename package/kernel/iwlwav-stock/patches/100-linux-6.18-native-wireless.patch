+static void wave618_flush_vap_stations(mtlk_vap_handle_t vap)
+{
+  mtlk_core_t *core = mtlk_vap_get_core(vap);
+  mtlk_df_user_t *user = mtlk_df_get_user(mtlk_vap_get_df(vap));
+  struct net_device *ndev = mtlk_df_user_get_ndev(user);
