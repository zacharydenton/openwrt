+int wave_pmf_key_add(mtlk_core_t *core, u8 index, struct key_params *params)
+{
+  struct crypto_shash *tfm = NULL, *old;
+  struct crypto_aead *gmac = NULL, *old_gmac;
+  bool is_gmac;
+  int err;
+  u64 ipn = 0;
+  unsigned int slot, i, key_len;
+
+  if (index < 4 || index > 5 || !params || !params->key)
+    return -EINVAL;
+  is_gmac = params->cipher == WLAN_CIPHER_SUITE_BIP_GMAC_128 ||
+            params->cipher == WLAN_CIPHER_SUITE_BIP_GMAC_256;
+  if (params->cipher == WLAN_CIPHER_SUITE_AES_CMAC ||
+      params->cipher == WLAN_CIPHER_SUITE_BIP_GMAC_128)
+    key_len = 16;
+  else if (params->cipher == WLAN_CIPHER_SUITE_BIP_CMAC_256 ||
+           params->cipher == WLAN_CIPHER_SUITE_BIP_GMAC_256)
+    key_len = 32;
+  else
+    return -EOPNOTSUPP;
+  if (params->key_len != key_len ||
+      (params->seq_len && (params->seq_len != 6 || !params->seq)))
+    return -EINVAL;
+  for (i = 0; i < params->seq_len; i++)
+    ipn |= (u64)params->seq[i] << (8 * i);
+  if (is_gmac) {
+    /* Exclude asynchronous implementations: management TX may run atomic. */
+    gmac = crypto_alloc_aead("gcm(aes)", 0, CRYPTO_ALG_ASYNC);
+    if (IS_ERR(gmac))
+      return PTR_ERR(gmac);
+    err = crypto_aead_setkey(gmac, params->key, key_len);
+    if (!err)
+      err = crypto_aead_setauthsize(gmac, 16);
+    if (err) {
+      crypto_free_aead(gmac);
+      return err;
+    }
+  } else {
+    tfm = crypto_alloc_shash("cmac(aes)", 0, 0);
+    if (IS_ERR(tfm))
+      return PTR_ERR(tfm);
+    if (crypto_shash_setkey(tfm, params->key, key_len)) {
+      crypto_free_shash(tfm);
+      return -EINVAL;
+    }
+  }
+  slot = index - 4;
+  mtlk_osal_lock_acquire(&core->net_state_lock);
+  old = core->slow_ctx->igtk_tfm[slot];
+  old_gmac = core->slow_ctx->igtk_gmac[slot];
