+/* Native hostapd has no vendor INITIAL_DATA command. Derive its 11b
+ * selector from the actual beacon rate IEs rather than a private ioctl.
+ */
+static bool wave_ap_11b_only(const struct cfg80211_ap_settings *info)
+{
+  const struct cfg80211_beacon_data *beacon = &info->beacon;
+  const u8 *parts[2];
+  size_t lengths[2], i, j;
+  bool found = false;
+
+  if (info->chandef.chan->band != NL80211_BAND_2GHZ ||
+      info->chandef.width != NL80211_CHAN_WIDTH_20_NOHT ||
+      beacon->head_len < offsetof(struct ieee80211_mgmt, u.beacon.variable))
+    return false;
+  parts[0] = beacon->head + offsetof(struct ieee80211_mgmt, u.beacon.variable);
+  lengths[0] = beacon->head_len - offsetof(struct ieee80211_mgmt, u.beacon.variable);
+  parts[1] = beacon->tail;
+  lengths[1] = beacon->tail_len;
+  for (i = 0; i < ARRAY_SIZE(parts); i++) {
+    const u8 *pos = parts[i];
+    size_t left = lengths[i];
+    while (left >= 2) {
+      size_t len = pos[1];
+      if (len > left - 2)
+        return false;
+      if (pos[0] == WLAN_EID_SUPP_RATES || pos[0] == WLAN_EID_EXT_SUPP_RATES) {
+        for (j = 0; j < len; j++) {
+          u8 rate = pos[2 + j] & 0x7f;
+          if (rate != 2 && rate != 4 && rate != 11 && rate != 22)
+            return false;
+          found = true;
+        }
+      }
+      pos += len + 2;
+      left -= len + 2;
+    }
+  }
+  return found;
 }
 
