@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+ * WAVE600 firmware HE wire format: extension ID + 6 MAC + 11 PHY bytes,
+ * two RX/TX MCS maps (<=80 and 160 MHz), and at most four NSS of PPE.
+ * The UMI layout is unchanged; only the host-side representation is adapted.
+ */
+#ifndef WAVE_HE_COMPAT_H
+#define WAVE_HE_COMPAT_H
+
+/* Pure byte serializer, also exercised by the host-side boundary tests. */
+static inline int wave_he_pack(unsigned char cap[18], unsigned char mcs[8],
+                               unsigned char ppe[13], const unsigned char *src,
+                               unsigned int len)
+{
+  unsigned int mcs_len, ppe_len = 0, nss, nrus = 0, bits, i;
+  if (!src || len < 21)
+    return -1;
+  mcs_len = 4 + ((src[6] & 0x08) ? 4 : 0) + ((src[6] & 0x10) ? 4 : 0);
+  if (len < 17 + mcs_len)
+    return -1;
+  if (src[12] & 0x80) {
+    if (len < 18 + mcs_len)
+      return -1;
+    for (i = 3; i < 7; i++)
+      nrus += !!(src[17 + mcs_len] & (1U << i));
+    nss = (src[17 + mcs_len] & 7) + 1;
+    ppe_len = (7 + nss * nrus * 6 + 7) / 8;
+    if (!nrus || len < 17 + mcs_len + ppe_len)
+      return -1;
+  }
+  cap[0] = 35; /* WLAN_EID_EXT_HE_CAPABILITY */
+  for (i = 0; i < 17; i++)
+    cap[i + 1] = src[i];
+  /* Firmware has no 80+80 map; retain contiguous 160 support. */
+  cap[7] &= ~0x10;
+  for (i = 0; i < 8; i++)
+    mcs[i] = 0xff;
+  for (i = 0; i < ((src[6] & 0x08) ? 8U : 4U); i++)
+    mcs[i] = src[17 + i];
+  for (i = 0; i < 13; i++)
+    ppe[i] = 0;
+  if (ppe_len) {
+    nss = (src[17 + mcs_len] & 7) + 1;
+    if (nss > 4)
+      nss = 4;
+    bits = 7 + nss * nrus * 6;
+    ppe_len = (bits + 7) / 8;
+    for (i = 0; i < ppe_len; i++)
+      ppe[i] = src[17 + mcs_len + i];
+    ppe[0] = (ppe[0] & ~7) | (nss - 1);
+    if (bits & 7)
+      ppe[ppe_len - 1] &= (1U << (bits & 7)) - 1;
+  }
+  return 0;
+}
+#endif
