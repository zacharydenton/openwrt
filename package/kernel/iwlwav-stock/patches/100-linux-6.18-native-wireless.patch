+++ b/wireless/driver/linux/cfg80211.c
@@ -63,10 +63,58 @@
 struct _wv_cfg80211_t
 {
   BOOL registered;
+  char regulatory_alpha2[2];
+  spinlock_t notify_lock;
+  struct list_head notify_list;
   /* mtlk_vap_manager_t *vap_manager;*/
   wave_radio_t *radio;
   struct wiphy *wiphy;
 };
+
+
+struct wave618_ch_event {
+  struct wiphy_work work;
+  struct list_head list;
+  struct net_device *ndev;
+  struct cfg80211_chan_def chandef;
+};
+
+static void wave618_ch_event_run(struct wiphy *wiphy, struct wiphy_work *work)
+{
+  struct wave618_ch_event *event = container_of(work, struct wave618_ch_event, work);
+  wv_cfg80211_t *cfg = wiphy_priv(wiphy);
+  unsigned long flags;
+  spin_lock_irqsave(&cfg->notify_lock, flags);
+  list_del(&event->list);
+  spin_unlock_irqrestore(&cfg->notify_lock, flags);
+  if (cfg->registered && event->ndev->reg_state == NETREG_REGISTERED &&
+      event->ndev->ieee80211_ptr && event->ndev->ieee80211_ptr->wiphy == wiphy)
+    cfg80211_ch_switch_notify(event->ndev, &event->chandef, 0);
+  dev_put(event->ndev);
+  kfree(event);
+}
+
+/* No cross-wiphy nested mutexes: notifications run under their own wiphy lock.
+ * Stop producers and cancel every owned work item before wiphy teardown. */
+static void wave618_ch_events_stop(wv_cfg80211_t *cfg)
+{
+  struct wave618_ch_event *event;
+  unsigned long flags;
+  wiphy_lock(cfg->wiphy);
+  spin_lock_irqsave(&cfg->notify_lock, flags);
+  cfg->registered = FALSE;
+  while (!list_empty(&cfg->notify_list)) {
+    event = list_first_entry(&cfg->notify_list, struct wave618_ch_event, list);
+    list_del(&event->list);
+    spin_unlock_irqrestore(&cfg->notify_lock, flags);
+    wiphy_work_cancel(cfg->wiphy, &event->work);
+    dev_put(event->ndev);
+    kfree(event);
+    spin_lock_irqsave(&cfg->notify_lock, flags);
+  }
+  spin_unlock_irqrestore(&cfg->notify_lock, flags);
+  wiphy_unlock(cfg->wiphy);
+}
 
