+  if (index < 4 || index > 5)
+    return -EINVAL;
+  slot = index - 4;
+  mtlk_osal_lock_acquire(&core->net_state_lock);
+  if (core->slow_ctx->igtk_tfm[slot] || core->slow_ctx->igtk_gmac[slot]) {
+    params.cipher = core->slow_ctx->igtk_cipher_suite[slot];
+    params.key_len = (params.cipher == WLAN_CIPHER_SUITE_AES_CMAC ||
+                      params.cipher == WLAN_CIPHER_SUITE_BIP_GMAC_128) ? 16 : 32;
+    memcpy(key, core->slow_ctx->igtk_key[slot], params.key_len);
+    ipn = core->slow_ctx->igtk_ipn[slot];
+    for (i = 0; i < 6; i++)
