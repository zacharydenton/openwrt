+  he->he_mcs_nss_supp.tx_mcs_160 = cpu_to_le16(width160 ? mcs : 0xffff);
+  he->he_mcs_nss_supp.rx_mcs_80p80 = cpu_to_le16(0xffff);
+  he->he_mcs_nss_supp.tx_mcs_80p80 = cpu_to_le16(0xffff);
+  /* Stock PPET16=0, PPET8=7 for all four RU sizes and supported NSS. */
+  he->ppe_thres[0] = (nss - 1) | 0x78;
