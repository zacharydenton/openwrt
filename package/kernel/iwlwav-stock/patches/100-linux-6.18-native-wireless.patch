+  core->slow_ctx->igtk_configured = false;
+  mtlk_osal_lock_release(&core->net_state_lock);
+  for (i = 0; i < 2; i++) {
+    if (old[i])
+      crypto_free_shash(old[i]);
+    if (old_gmac[i])
