+static void wave_pmf_reset(mtlk_core_t *core)
+{
+  struct crypto_shash *old[2];
+  struct crypto_aead *old_gmac[2];
+  unsigned int i;
+
+  mtlk_osal_lock_acquire(&core->net_state_lock);
+  for (i = 0; i < 2; i++) {
+    old[i] = core->slow_ctx->igtk_tfm[i];
+    old_gmac[i] = core->slow_ctx->igtk_gmac[i];
+    core->slow_ctx->igtk_gmac[i] = NULL;
+    core->slow_ctx->igtk_tfm[i] = NULL;
+    core->slow_ctx->igtk_ipn[i] = 0;
+    core->slow_ctx->igtk_cipher_suite[i] = 0;
