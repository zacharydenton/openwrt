+  if (!mtlk_vap_is_ap(vap) || !ndev || ndev->reg_state != NETREG_REGISTERED)
+    return;
+  sta = mtlk_stadb_iterate_first(&core->slow_ctx->stadb, &iter);
+  if (!sta)
+    return;
+  do {
+    cfg80211_del_sta(ndev, mtlk_sta_get_addr(sta)->au8Addr, GFP_KERNEL);
+    sta = mtlk_stadb_iterate_next(&iter);
+  } while (sta);
+  mtlk_stadb_iterate_done(&iter);
+}
