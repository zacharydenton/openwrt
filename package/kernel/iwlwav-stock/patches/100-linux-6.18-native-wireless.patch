+  he->has_he = true;
+  mac[0] = IEEE80211_HE_MAC_CAP0_HTC_HE;
+  mac[2] = IEEE80211_HE_MAC_CAP2_ACK_EN;
+  mac[3] = IEEE80211_HE_MAC_CAP3_OMI_CONTROL |
+           IEEE80211_HE_MAC_CAP3_MAX_AMPDU_LEN_EXP_EXT_2;
+  mac[4] = IEEE80211_HE_MAC_CAP4_AMSDU_IN_AMPDU;
+  mac[5] = IEEE80211_HE_MAC_CAP5_OM_CTRL_UL_MU_DATA_DIS_RX;
+  if (band_5ghz)
+    mac[5] |= IEEE80211_HE_MAC_CAP5_UL_2x996_TONE_RU;
+  phy[0] = band_5ghz ? IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_80MHZ_IN_5G :
+                      IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_IN_2G |
+                      IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_RU_MAPPING_IN_2G;
+  if (width160)
+    phy[0] |= IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_160MHZ_IN_5G;
+  phy[1] = IEEE80211_HE_PHY_CAP1_DEVICE_CLASS_A |
+           IEEE80211_HE_PHY_CAP1_LDPC_CODING_IN_PAYLOAD;
+  phy[2] = IEEE80211_HE_PHY_CAP2_NDP_4x_LTF_AND_3_2US;
+  phy[3] = IEEE80211_HE_PHY_CAP3_SU_BEAMFORMER;
+  phy[4] = IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE |
+           IEEE80211_HE_PHY_CAP4_MU_BEAMFORMER |
+           IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_UNDER_80MHZ_4 |
+           IEEE80211_HE_PHY_CAP4_BEAMFORMEE_MAX_STS_ABOVE_80MHZ_4;
+  phy[5] = (nss - 1) | ((nss - 1) << 3) |
+           IEEE80211_HE_PHY_CAP5_NG16_SU_FEEDBACK;
+  phy[6] = IEEE80211_HE_PHY_CAP6_TRIG_SU_BEAMFORMING_FB |
+           IEEE80211_HE_PHY_CAP6_PPE_THRESHOLD_PRESENT;
+  phy[7] = IEEE80211_HE_PHY_CAP7_HE_SU_MU_PPDU_4XLTF_AND_08_US_GI |
