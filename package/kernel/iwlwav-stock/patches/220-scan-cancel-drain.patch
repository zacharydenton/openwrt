+void wave_radio_scan_quiesce(wave_radio_descr_t *radio_descr)
+{
+  wave_int i;
+
+  if (!radio_descr)
+    return;
+
+  /* The synchronous master-serializer request runs after any queued scan
+   * work, aborts an active scan and prevents another one from starting.
+   * Complete scan callbacks while both AP and STA wiphys still exist.
+   */
+  for (i = 0; i < radio_descr->num_radios; i++) {
+    wave_radio_t *radio = &radio_descr->radio[i];
+
+    if (radio->init_done) {
+      scan_support_prepare_remove(wave_radio_scan_support_get(radio));
+      _wave_radio_abort_and_prevent_scan(radio);
+    }
+  }
 }
 
