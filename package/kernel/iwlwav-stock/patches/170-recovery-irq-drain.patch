+        !(obj->recovery_disabled_irqs & BIT(i))) {
+      disable_irq(obj->irq_out[i]);
+      obj->recovery_disabled_irqs |= BIT(i);
+    }
+  }
+#endif
+  _mmb_drv_drain_tasklets(obj);
+  mtlk_hw_mmb_dis_interrupts(hw);
+}
+
+void __MTLK_IFUNC
+mtlk_mmb_drv_recovery_irq_resume(mtlk_hw_t *hw)
+{
+#ifndef MTCFG_USE_INTERRUPT_POLLING
+  mtlk_mmb_drv_t *obj = container_of(mtlk_hw_mmb_get_ccr(hw), mtlk_mmb_drv_t, ccr);
+  int i;
+
+  for (i = 0; i < obj->nof_irqs; i++) {
+    if (obj->recovery_disabled_irqs & BIT(i)) {
+      obj->irq_handler_data[i].status = MTLK_IRQ_NONE;
+      obj->recovery_disabled_irqs &= ~BIT(i);
+      enable_irq(obj->irq_out[i]);
+    }
+  }
+#endif
 }
 
