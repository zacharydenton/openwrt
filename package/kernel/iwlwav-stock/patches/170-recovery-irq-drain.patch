+void __MTLK_IFUNC
+mtlk_mmb_drv_recovery_irq_quiesce(mtlk_hw_t *hw)
+{
+  mtlk_mmb_drv_t *obj = container_of(mtlk_hw_mmb_get_ccr(hw), mtlk_mmb_drv_t, ccr);
+#ifndef MTCFG_USE_INTERRUPT_POLLING
