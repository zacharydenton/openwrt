+struct mtlk_scan_quiesce {
+  struct completion done;
+  mtlk_core_t *core;
+  BOOL executed;
+};
+
+static void
+_mtlk_core_remove_scan(mtlk_handle_t context)
+{
+  struct mtlk_scan_quiesce *quiesce = (struct mtlk_scan_quiesce *)context;
+
+  /* Removal cleanup must run even if recovery cancelled user commands or
+   * disabled the ALTER_SCAN ability. removal_pending suppresses FW restore. */
+  abort_scan_sync(quiesce->core);
+  pause_or_prevent_scan(quiesce->core);
+  quiesce->executed = TRUE;
+}
+
+static void
+_mtlk_core_remove_scan_done(serializer_result_t result, mtlk_command_t *command,
+                           mtlk_handle_t context)
+{
+  struct mtlk_scan_quiesce *quiesce = (struct mtlk_scan_quiesce *)context;
+
+  complete(&quiesce->done);
+}
+
+void __MTLK_IFUNC
+mtlk_core_scan_quiesce(mtlk_core_t *core)
+{
+  struct mtlk_scan_quiesce quiesce;
+  mtlk_command_t command;
+  int res;
+
+  /* The card removal owner calls this after closing channel admission, while
+   * the master serializer is alive and before VAP stop. No concurrent master
+   * start/stop is allowed. A stack command needs no clipboard/heap allocation. */
+  init_completion(&quiesce.done);
+  quiesce.core = core;
+  quiesce.executed = FALSE;
+  res = mtlk_command_init(&command, _mtlk_core_remove_scan, HANDLE_T(&quiesce), MTLK_SLID);
+  if (res == MTLK_ERR_OK) {
+    /* Same FIFO priority as SET_CHAN and CAC_TIMEOUT: never overtake them. */
+    res = mtlk_serializer_enqueue(&core->slow_ctx->serializer,
+                                 _MTLK_CORE_PRIORITY_USER, &command,
+                                 _mtlk_core_remove_scan_done, HANDLE_T(&quiesce));
+    if (res == MTLK_ERR_OK)
+      wait_for_completion(&quiesce.done);
+    mtlk_command_cleanup(&command);
+  }
+
+  if (!quiesce.executed) {
+    /* A stopped/rejecting serializer is exceptional for an initialized radio.
+     * Finish its stop (including the worker join) before local scan cleanup;
+     * never let failure of the barrier leave callbacks behind unregister.
+     * The lifecycle owner will later call the idempotent serializer stop again. */
+    ELOG_D("Removal scan barrier unavailable (%d), draining serializer", res);
+    mtlk_serializer_stop(&core->slow_ctx->serializer);
+    _mtlk_core_remove_scan(HANDLE_T(&quiesce));
+  }
+}
