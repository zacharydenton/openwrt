+static int
+wave_bss_tx_map(mtlk_hw_t *hw, struct mtlk_hw_bss_req_mirror *req)
+{
+  /* Never overwrite the ownership record of an outstanding mapping. */
+  if (req->dma_mapped)
+    return MTLK_ERR_UNKNOWN;
+
+  req->dma_addr = mtlk_osal_map_to_phys_addr(mtlk_ccr_get_dev_ctx(hw->ccr),
+                                          req->virt_addr, req->size,
+                                          MTLK_DATA_TO_DEVICE);
+  if (dma_mapping_error(mtlk_ccr_get_dev_ctx(hw->ccr), req->dma_addr)) {
+    req->dma_addr = 0;
+    return MTLK_ERR_NO_MEM;
+  }
+  req->dma_mapped = true;
+  return MTLK_ERR_OK;
+}
+
+static void
+wave_bss_tx_unmap(mtlk_hw_t *hw, struct mtlk_hw_bss_req_mirror *req)
+{
+  if (req->dma_mapped) {
+    mtlk_osal_unmap_phys_addr(mtlk_ccr_get_dev_ctx(hw->ccr), req->dma_addr,
+                            req->size, MTLK_DATA_TO_DEVICE);
+    req->dma_mapped = false;
+  }
+  req->dma_addr = 0;
+}
+
+/* Call only with submission/completion processing quiesced, as for the
+ * existing RX/data-TX cleanup paths. DMA address zero can be a valid mapping.
+ */
+static void
+_mtlk_mmb_unmap_bss_tx_buffers(mtlk_hw_t *hw, mtlk_mmb_advanced_bdr_t *control)
+{
+  int i;
+
+  for (i = 0; i < control->basic.nof_bds; i++) {
+    struct mtlk_hw_bss_req_mirror *req =
+      _mtlk_basic_bdr_get_mirror_bd(&control->basic, i, struct mtlk_hw_bss_req_mirror);
+    wave_bss_tx_unmap(hw, req);
+  }
+}
