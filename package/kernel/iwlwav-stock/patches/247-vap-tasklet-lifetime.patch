+uint32 __MTLK_IFUNC
+mtlk_mmb_drv_vap_tasklets_pause(mtlk_hw_t *hw)
+{
+  mtlk_mmb_drv_t *obj = container_of(mtlk_hw_mmb_get_ccr(hw), mtlk_mmb_drv_t, ccr);
+  uint32 mask = 0;
+  int i;
+
+  if (!READ_ONCE(obj->tasklets_initialized))
+    return 0;
+
+  for (i = 0; i < obj->nof_irqs; i++) {
+    if (_mmb_drv_is_irqno_required(hw, obj->irq_handler_data[i].irq_no)) {
+      tasklet_disable(&obj->irq_tasklet[i]);
+      mask |= BIT(i);
+    }
+  }
+  if (obj->ihd_pending) {
+    tasklet_disable(&obj->irq_tasklets_global[0]);
+    mask |= BIT(IRQS_TO_HANDLE);
+  }
+  return mask;
+}
+
+void __MTLK_IFUNC
+mtlk_mmb_drv_vap_tasklets_resume(mtlk_hw_t *hw, uint32 mask)
+{
+  mtlk_mmb_drv_t *obj = container_of(mtlk_hw_mmb_get_ccr(hw), mtlk_mmb_drv_t, ccr);
+  int i;
+
+  if (mask & BIT(IRQS_TO_HANDLE))
+    tasklet_enable(&obj->irq_tasklets_global[0]);
+  for (i = obj->nof_irqs - 1; i >= 0; i--) {
+    if (mask & BIT(i))
+      tasklet_enable(&obj->irq_tasklet[i]);
+  }
 }
 
