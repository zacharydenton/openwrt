+void __MTLK_IFUNC
+mtlk_df_user_quiesce_prop_dfs_wq (mtlk_df_user_t *df_user)
+{
+  mtlk_dlist_entry_t *head, *entry;
+  mtlk_dfs_state_cfg_t *dfs_state_cfg;
+  unsigned long flags;
+
+  if (!df_user || !df_user->propagate_dfs_state_wq)
+    return;
+
+  /* Close admission before draining. A queued callback finishes while its
+   * wiphy is registered; no later producer can call cfg80211 after removal.
+   */
+  spin_lock_irqsave(&df_user->prop_dfs_gate_lock, flags);
+  df_user->prop_dfs_closing = TRUE;
+  spin_unlock_irqrestore(&df_user->prop_dfs_gate_lock, flags);
+
+  flush_workqueue(df_user->propagate_dfs_state_wq);
+
+  /* An event may have been added just before closure but never scheduled. */
+  mtlk_osal_mutex_acquire(&df_user->prop_dfs_mutex);
+  mtlk_dlist_foreach(&df_user->propagate_dfs_state_list, entry, head) {
+    dfs_state_cfg = MTLK_LIST_GET_CONTAINING_RECORD(entry, mtlk_dfs_state_cfg_t, lentry);
+    entry = mtlk_dlist_remove(&df_user->propagate_dfs_state_list, entry);
+    mtlk_osal_mem_free(dfs_state_cfg);
+  }
+  mtlk_osal_mutex_release(&df_user->prop_dfs_mutex);
