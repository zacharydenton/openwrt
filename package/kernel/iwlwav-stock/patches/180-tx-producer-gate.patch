+/* Fast-path enter/exit may run in atomic context. Close/drain must run in
+ * process context outside a transaction. Recovery transitions are serialized
+ * by their caller; permanent stop cannot be undone by a late resume.
+ */
+bool __MTLK_IFUNC wave_hw_tx_enter(mtlk_hw_t *hw);
+void __MTLK_IFUNC wave_hw_tx_exit(mtlk_hw_t *hw);
+void __MTLK_IFUNC wave_hw_tx_quiesce(mtlk_hw_t *hw);
+void __MTLK_IFUNC wave_hw_tx_stop(mtlk_hw_t *hw);
+void __MTLK_IFUNC wave_hw_tx_resume(mtlk_hw_t *hw);
 
