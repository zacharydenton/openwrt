+/* Covers a complete accepted TX transaction, including descriptor borrowing.
+ * Closing waits for its users, not merely for the last ring write.
+ */
+struct wave_tx_gate {
+  spinlock_t lock;
+  wait_queue_head_t wait;
+  unsigned int users;
+  bool accepting;
+  bool stopping;
+};
+
 struct _mtlk_hw_t
 {
+  struct wave_tx_gate tx_gate;
+  struct work_struct reset_work;
   mtlk_ccr_t            *ccr;
   mtlk_hw_mmb_t         *mmb;
   unsigned char         *mmb_base;
@@ -5315,6 +5331,132 @@
   mtlk_ccr_clear_boot_from_bus(hw->ccr);
   mtlk_ccr_put_ctl_to_reset(hw->ccr);
   ILOG0_V("FW CPU reset is done");
+}
+
+static void
+wave_hw_reset_worker(struct work_struct *work)
+{
+  mtlk_hw_t *hw = container_of(work, mtlk_hw_t, reset_work);
+  unsigned long flags;
+  bool stopping;
+
+  spin_lock_irqsave(&hw->tx_gate.lock, flags);
+  stopping = hw->tx_gate.stopping;
+  spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
+  if (!stopping && !mtlk_hw_is_halted(READ_ONCE(hw->state))) {
+    wave_rcvry_task_initiate(hw);
+    _mtlk_mmb_handle_sw_trap(hw);
+  }
+}
+
+static int
+wave_hw_reset_request(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+  int res = MTLK_ERR_NOT_READY;
+
+  spin_lock_irqsave(&hw->tx_gate.lock, flags);
+  if (!hw->tx_gate.stopping && !mtlk_hw_is_halted(READ_ONCE(hw->state))) {
+    /* Serialize enqueue with permanent stop's cancel_work_sync. Initiation
+     * can take recovery mutexes, so never run it in a TX/IRQ transaction.
+     */
+    schedule_work(&hw->reset_work);
+    res = MTLK_ERR_OK; /* request accepted, not recovery completion */
+  }
+  spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
+  return res;
+}
+
+static void
+wave_hw_tx_gate_init(mtlk_hw_t *hw)
+{
+  spin_lock_init(&hw->tx_gate.lock);
+  init_waitqueue_head(&hw->tx_gate.wait);
+  hw->tx_gate.users = 0;
+  hw->tx_gate.accepting = false;
+  hw->tx_gate.stopping = false;
+  INIT_WORK(&hw->reset_work, wave_hw_reset_worker);
+}
+
+bool __MTLK_IFUNC
+wave_hw_tx_enter(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+  bool accepted;
+
+  spin_lock_irqsave(&hw->tx_gate.lock, flags);
+  accepted = hw->tx_gate.accepting;
+  if (accepted)
+    hw->tx_gate.users++;
+  spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
+  return accepted;
+}
+
+void __MTLK_IFUNC
+wave_hw_tx_exit(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&hw->tx_gate.lock, flags);
+  if (WARN_ON_ONCE(!hw->tx_gate.users)) {
+    spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
+    return;
+  }
+  if (!--hw->tx_gate.users)
+    wake_up_all(&hw->tx_gate.wait);
+  spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
+}
+
+static bool
+wave_hw_tx_idle(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+  bool idle;
+
+  /* Take the lock so drain cannot return while the last exit still touches
+   * the gate (including its waitqueue wakeup).
+   */
+  spin_lock_irqsave(&hw->tx_gate.lock, flags);
+  idle = !hw->tx_gate.users;
+  spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
+  return idle;
+}
+
+static void
+wave_hw_tx_drain(mtlk_hw_t *hw, bool permanent)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&hw->tx_gate.lock, flags);
+  if (permanent)
+    hw->tx_gate.stopping = true;
+  hw->tx_gate.accepting = false;
+  spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
+  wait_event(hw->tx_gate.wait, wave_hw_tx_idle(hw));
+}
+
+void __MTLK_IFUNC
+wave_hw_tx_quiesce(mtlk_hw_t *hw)
+{
+  wave_hw_tx_drain(hw, false);
+}
+
+void __MTLK_IFUNC
+wave_hw_tx_stop(mtlk_hw_t *hw)
+{
+  wave_hw_tx_drain(hw, true);
+  cancel_work_sync(&hw->reset_work);
+}
+
+void __MTLK_IFUNC
+wave_hw_tx_resume(mtlk_hw_t *hw)
+{
+  unsigned long flags;
+
+  spin_lock_irqsave(&hw->tx_gate.lock, flags);
+  if (!hw->tx_gate.stopping)
+    hw->tx_gate.accepting = true;
+  spin_unlock_irqrestore(&hw->tx_gate.lock, flags);
 }
 
