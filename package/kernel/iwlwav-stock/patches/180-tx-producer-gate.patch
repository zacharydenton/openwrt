+int
+mtlk_mmb_bss_mgmt_tx (mtlk_vap_handle_t vap_handle, const uint8 *buf, size_t len, int channum,
+                      BOOL no_cck, BOOL dont_wait_for_ack, BOOL is_broadcast,
+                      uint64 *cookie, uint32 extra_processing, mtlk_nbuf_t *skb,
+                      BOOL power_mgmt_on, uint32 tid)
+{
+  mtlk_hw_t *hw = mtlk_vap_get_hw(vap_handle);
+  int res;
+
+  if (!wave_hw_tx_enter(hw))
+    return MTLK_ERR_NOT_READY; /* caller retains its skb */
+  res = _mtlk_mmb_bss_mgmt_tx_submit(vap_handle, buf, len, channum, no_cck,
+                                  dont_wait_for_ack, is_broadcast, cookie,
+                                  extra_processing, skb, power_mgmt_on, tid);
+  wave_hw_tx_exit(hw);
+  return res;
+}
